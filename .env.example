# Root env file consumed by docker-compose.yml for variable substitution.
# Copy to .env before running `docker compose up`.
# Per-service local dev (without Docker) uses each service's own .env —
# see frontend/.env.example, backend/.env.example, ai/.env.example.

POSTGRES_USER=virtualtryon
POSTGRES_PASSWORD=virtualtryon
POSTGRES_DB=virtualtryon
POSTGRES_PORT=5432

REDIS_PORT=6379

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_SECRET_KEY=change-me

# "cpu" unless the host has an NVIDIA GPU + Container Toolkit configured.
AI_DEVICE=cpu
