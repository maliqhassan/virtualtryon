# Expo only inlines vars prefixed EXPO_PUBLIC_ into the client bundle.
# Copy this file to .env and fill in values for local development.

# `localhost` here only resolves correctly for the web target and the iOS
# Simulator (both share the host machine's network). A physical phone or an
# Android emulator will NOT reach a backend at `localhost` — that resolves
# to the device itself, not your dev machine. Use your machine's LAN IP
# instead (e.g. http://192.168.1.23:8000), or the Android emulator's host
# loopback alias (http://10.0.2.2:8000). Getting this wrong looks exactly
# like "the backend is down" from the app's perspective — the upload layer's
# mock-fallback will silently mask it, which is convenient for development
# but worth knowing which one you're actually hitting.
EXPO_PUBLIC_API_URL=http://localhost:8000
