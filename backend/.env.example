# Copy to .env and fill in values for local development.

APP_ENV=development
DEBUG=true

# Async (asyncpg) URL used by the app itself.
DATABASE_URL=postgresql+asyncpg://virtualtryon:virtualtryon@localhost:5432/virtualtryon

REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

CORS_ORIGINS=["http://localhost:8081"]

# Which AI client the worker uses for try-ons:
#   demo    - no real AI; returns your photo with the garment pinned on and a
#             "DEMO RESULT · AI NOT CONNECTED" banner, so the full app flow can
#             be tested before a real try-on API is connected (default)
#   catvton - unimplemented stub; every try-on fails
# false while testing: no try-on limits.
TRYON_LIMITS_ENABLED=true
TRYON_PROVIDER=demo

# Reject user photos where MediaPipe can't see a full body (head to feet).
FULL_BODY_CHECK_ENABLED=true

# RapidAPI key for guessing a new wardrobe piece's category from its photo
# (api4.ai fashion model). Leave empty to turn it off. Each call costs a
# credit; FASHION_API_DAILY_LIMIT caps calls a day across all users.
FASHION_API_KEY=
FASHION_API_DAILY_LIMIT=10

# Firebase project id for Google sign-in (ADR 0012), e.g. virtualtryon-1a2b3.
# Firebase console → Project settings → General → Project ID. Empty turns
# Google sign-in off.
FIREBASE_PROJECT_ID=
